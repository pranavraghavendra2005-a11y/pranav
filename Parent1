package super_keyword;

 class Parent1 {
	void show() {
		System.out.println("parent static method");
	}

}

package super_keyword;

public class Child extends Parent1 {
	@Override
	
		void show() {
			System.out.println("parent static method");
		}
		public static void main(String[] args) {
			Parent1 obj = new Child();
			obj.show();
		}
	}



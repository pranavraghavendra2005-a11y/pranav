import java.util.Scanner;

public class reverse {
    public static void main(String[] args) {

        System.out.println("Enter no = ");
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int rev = 0;
        int d;

        while (n != 0) {
            d = n % 10;
            rev = rev * 10 + d;
            n = n / 10;
        }

        System.out.println("rev is = " + rev);
    }
}


